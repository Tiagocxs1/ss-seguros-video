function Brackets({ theme }: { theme: Theme }) {
  return (
    <AbsoluteFill>
      <div style={{ position: "absolute", width: 120, height: 120, border: `4px solid ${theme.bracket}`, opacity: .5, top: 40, left: 40, borderRight: "none", borderBottom: "none", borderRadius: "24px 0 0 0" }} />
      <div style={{ position: "absolute", width: 120, height: 120, border: `4px solid ${theme.bracket}`, opacity: .5, top: 40, right: 40, borderLeft: "none", borderBottom: "none", borderRadius: "0 24px 0 0" }} />
      <div style={{ position: "absolute", width: 120, height: 120, border: `4px solid ${theme.bracket}`, opacity: .5, bottom: 40, left: 40, borderRight: "none", borderTop: "none", borderRadius: "0 0 0 24px" }} />
      <div style={{ position: "absolute", width: 120, height: 120, border: `4px solid ${theme.bracket}`, opacity: .5, bottom: 40, right: 40, borderLeft: "none", borderTop: "none", borderRadius: "0 0 24px 0" }} />
    </AbsoluteFill>
  );
}

function createFrame(config: { name: string; themeKey: string; bg: number; bgStyle: string; textures: string[]; particleCol?: string; badge?: string; sides?: boolean; brackets?: boolean; defaultTitle: string; defaultSubtitle: string }) {
  const { name, themeKey, bg, bgStyle, textures, particleCol, badge, sides, brackets, defaultTitle, defaultSubtitle } = config;
  const theme = themes[themeKey];
  const bs = bgStyles[bgStyle];
  const topGrad = bs.topGrad === "t-d" ? `linear-gradient(180deg, rgba(${theme.darkRgb},.95) 0%, rgba(${theme.accentRgb},.12) 50%, transparent 100%)` : bs.topGrad;
  const botGrad = bs.botGrad === "b-d" ? `linear-gradient(0deg, rgba(${theme.darkRgb},.95) 0%, rgba(${theme.accentRgb},.12) 50%, transparent 100%)` : bs.botGrad;

  const Frame: React.FC<FrameVariantProps> = ({
    videoSrc,
    title = defaultTitle,
    subtitle = defaultSubtitle,
    phone = "(48) 3234-9001",
    ctaText = "Link na Bio",
    ctaUrl = "https://wa.me/554832349001",
  }) => {
    const frame = useCurrentFrame();
    const video = videoSrc ? <VideoOverlay videoSrc={videoSrc} frame={frame} /> : null;

    return (
      <AbsoluteFill style={{ backgroundColor: colors.fundoEscuro }}>
        {/* BACKGROUND LAYER - Full frame Guardian theme */}
        <TextureLayers textures={textures} theme={theme} particleCol={particleCol} variantId={name} />

        {/* VIDEO OVERLAY - Centered, inset 82% */}
        {video}

        {/* OVERLAY BARS - On top of everything */}
        <TopBar theme={theme} topGrad={topGrad} title={title} subtitle={subtitle} badge={badge} frame={frame} />
        <BottomBar theme={theme} botGrad={botGrad} phone={phone} ctaText={ctaText} ctaUrl={ctaUrl} frame={frame} />

        {sides && <SideBars theme={theme} />}
        {brackets && <Brackets theme={theme} />}
      </AbsoluteFill>
    );
  };

  Frame.displayName = `Frame${name}`;
  return Frame;
}

// ===== 6 FRAMES: BACKGROUND + VIDEO INSET =====
export const FrameCiano = createFrame({ name: "Ciano", themeKey: "cyan", bg: 0, bgStyle: "gridStrong", textures: ["grain", "scan", "grid", "rings", "radial"], defaultTitle: "Portaria Autônoma", defaultSubtitle: "Sua segurança evoluiu" });
export const FrameVermelho = createFrame({ name: "Vermelho", themeKey: "red", bg: 3, bgStyle: "redTint", textures: ["grain", "scan", "mesh", "light"], defaultTitle: "Alerta de Segurança", defaultSubtitle: "Resposta imediata 24/7" });
export const FrameAzul = createFrame({ name: "Azul", themeKey: "blue", bg: 2, bgStyle: "gridStrong", textures: ["grain", "grid", "radial", "rings"], defaultTitle: "Segurança Institucional", defaultSubtitle: "Tecnologia a serviço da proteção" });
export const FrameGrafite = createFrame({ name: "Grafite", themeKey: "graphite", bg: 4, bgStyle: "desat", textures: ["grain", "scan", "grid", "mesh"], defaultTitle: "Monitoramento Neutro", defaultSubtitle: "Eficiência sem ruído visual" });
export const FrameBrancoPredominante = createFrame({ name: "BrancoPredominante", themeKey: "white", bg: 0, bgStyle: "whitePure", textures: ["grain", "scan", "grid", "light"], defaultTitle: "Proteção Clara", defaultSubtitle: "Transparência total na segurança" });
export const FrameBrancoMinimal = createFrame({ name: "BrancoMinimal", themeKey: "white", bg: 4, bgStyle: "minimal", textures: ["grain"], badge: "24/7", defaultTitle: "24/7", defaultSubtitle: "Sempre vigilante" });