function SideBars({ theme }: { theme: Theme }) {
  return (
    <AbsoluteFill>
      <div style={{ position: "absolute", top: 0, bottom: 0, left: 0, width: 8, background: theme.sideGrad, opacity: .5 }} />
      <div style={{ position: "absolute", top: 0, bottom: 0, right: 0, width: 8, background: theme.sideGrad, opacity: .5 }} />
    </AbsoluteFill>
